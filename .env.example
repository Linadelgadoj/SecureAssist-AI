# FastAPI
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Auth (servidor únicamente; nunca usar prefijo VITE_ para estas variables)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=secureassist_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_SECONDS=

# Login de prueba SOLO para desarrollo local: usuario fijo y conversaciones en memoria, sin Supabase.
# Solo se permite con APP_ENV=development. Dejar en false para usar Google/Supabase real.
DEV_LOGIN=false

# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL local (docker compose up -d db). Si DATABASE_URL está vacío se usa
# Supabase o, con DEV_LOGIN=true, almacenamiento en memoria.
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5434
DATABASE_URL=postgresql://secureassist:cambia-esta-clave@127.0.0.1:5434/secureassist
# Base de pruebas (la crea el contenedor). pytest omite las pruebas de PostgreSQL si no está definida.
TEST_DATABASE_URL=postgresql://secureassist:cambia-esta-clave@127.0.0.1:5434/secureassist_test

# Correos separados por coma que siempre tienen rol administrador.
# El resto de usuarios entra como técnico; un administrador puede cambiar roles.
ADMIN_EMAILS=
