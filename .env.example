# FastAPI
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Auth (servidor únicamente; nunca usar prefijo VITE_ para estas variables)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=secureassist_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_SECONDS=

# Login de prueba SOLO para desarrollo local: usuario fijo y conversaciones en memoria, sin Supabase.
# Solo se permite con APP_ENV=development. Dejar en false para usar Google/Supabase real.
DEV_LOGIN=false

# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000/api/v1
